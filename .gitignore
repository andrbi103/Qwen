```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Build directories
dist/
build/
target/
.gradle/

# Python specific
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
.ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/modules/
*.sublime-workspace
.pytest_cache/
.mypy_cache/
.hypothesis/

# PHP specific
*.php~
*.php.bak
*.php.swp
*.php.swo

# Web
*.min.js
*.min.css
public/build/
public/dist/

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```